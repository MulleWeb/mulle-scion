{# named method arguments are converted to the type the method signature
   declares. Each line pins one argument type: char, short, int, long,
   long long, their unsigned variants, float, double, BOOL, NSUInteger,
   unichar, SEL and the NSRange struct
#}
{{ [NSNumber numberWithChar:65] }}
{{ [NSNumber numberWithShort:-123] }}
{{ [NSNumber numberWithInt:-1848] }}
{{ [NSNumber numberWithLong:1234567890] }}
{{ [NSNumber numberWithLongLong:-5000000000] }}
{{ [NSNumber numberWithUnsignedChar:200] }}
{{ [NSNumber numberWithUnsignedShort:40000] }}
{{ [NSNumber numberWithUnsignedInt:4000000000] }}
{{ [NSNumber numberWithUnsignedLong:10000000000] }}
{{ [NSNumber numberWithUnsignedLongLong:1848] }}
{{ [NSNumber numberWithFloat:1.5] }}
{{ [NSNumber numberWithDouble:1.5] }}
{{ [NSNumber numberWithBool:1] }}
{{ [@"abcdef" substringToIndex:2] }}
{{ [@"abcdef" substringFromIndex:3] }}
{{ [@"abc" characterAtIndex:1] }}
{{ [@"abc" performSelector:@selector(description)] }}
{{ [@"abcdef" substringWithRange:NSMakeRange(2,3)] }}
