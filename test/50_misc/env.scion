{%
   isWindows  = [[[NSProcessInfo processInfo] operatingSystemName] isEqualToString:"Windows"]
   cmd        = isWindows ? "cmd.exe /c set" : "env"
   taskInfo   = [NSTask mulleStringSystemCallWithCommandString:cmd
                                                   environment:@{ "FOO": "VfL Bochum 1848"}]
   output     = taskInfo["standardOutputString"]
   error      = taskInfo["standardErrorString"]
%}
{% for line in [output componentsSeparatedByString:"\n"] %}
{% if [line hasPrefix:"FOO"] %}
{{ line }}
{% endif %}
{% endfor %}
{% if( [error length]) %}

stderr:
{{ error }}
{% endif %}
